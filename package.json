{
  "name": "vsmd",
  "displayName": "VSMD - Markdown Preview",
  "description": "A VSCode extension to render Markdown files as HTML",
  "icon": "logo.png",
  "version": "1.0.0",
  "publisher": "huachao",
  "repository": "https://github.com/huachao1001/vsmd",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "markdown",
    "preview",
    "html"
  ],
  "author": "vsmd",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "highlight.js": "^11.11.1",
    "marked": "^5.1.2"
  },
  "contributes": {
    "configuration": {
      "title": "VSMD",
      "properties": {
        "vsmd.themesDirectory": {
          "type": "string",
          "default": "",
          "description": "Custom themes directory (default: ~/.vsmd/themes)"
        }
      }
    },
    "commands": [
      {
        "command": "vsmd.togglePreview",
        "title": "Toggle Markdown Preview",
        "icon": "$(markdown)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "vsmd.togglePreview",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ]
    }
  },
  "activationEvents": [
    "onCommand:vsmd.togglePreview"
  ],
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
